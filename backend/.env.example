# Port the NestJS API listens on
PORT=4000

# SQLite3 database file (relative to the backend folder)
DATABASE_PATH=../database/app.sqlite

# Let TypeORM keep the schema in sync with the entities (fine for SQLite; set false once you add migrations)
DB_SYNCHRONIZE=true

# Origin of the Next.js frontend (only needed if the browser calls the API directly instead of via the Next proxy)
FRONTEND_ORIGIN=http://localhost:3000

# Admin sign-in passcode. CHANGE THIS before deploying.
ADMIN_PASSCODE=callahan

# Secret used to sign admin sessions and contact-form tokens. Use a long random string in production.
APP_SECRET=change-me-to-a-long-random-string

# Admin session length in hours
ADMIN_SESSION_HOURS=8
